    f460 :          WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f461 :          SET : vLen : $$StringLength:##vRec
    f462 :       END IF
    f463 :       WRITE FILE : ##vRec
    f464 :       SET : vNK : 0
    f465 :       SET : vNK : $$CollectionField:($$CollectionField:($$NumItems:PayHeadAllocations):##vJ:EmployeeEntries):##vI:CategoryEntry
    f466 :       SET : vK : 1
    f467 :       WHILE : ##vK <= ##vNK
    f468 :          SET : vRec : "|CE" + ($$String:##vI) + "E" + ($$String:##vJ) + "p" + ($$String:##vK) + "=" + ($$CollectionField:($$CollectionField:(($$CollectionField:@@FCRFPh:##vK:PayHeadAllocations)):##vJ:EmployeeEntries):##vI:CategoryEntry)
    f469 :          SET : vLen : ##vLen + ($$StringLength:##vRec)
    f470 :          IF : ##vLen > @@FCRCap
    f471 :             SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f472 :             WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f473 :             INCREMENT : vPart
    f474 :             WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f475 :             SET : vLen : $$StringLength:##vRec
    f476 :          END IF
    f477 :          WRITE FILE : ##vRec
    f478 :          INCREMENT : vK
    f479 :       END WHILE
    f480 :       SET : vNK : 0
    f481 :       SET : vNK : $$CollectionField:($$CollectionField:($$NumItems:AttendanceEntries):##vJ:EmployeeEntries):##vI:CategoryEntry
    f482 :       SET : vK : 1
    f483 :       WHILE : ##vK <= ##vNK
    f484 :          SET : vRec : "|CE" + ($$String:##vI) + "E" + ($$String:##vJ) + "a" + ($$String:##vK) + "=" + ($$CollectionField:($$CollectionField:(($$CollectionField:@@FCRFAtt:##vK:AttendanceEntries)):##vJ:EmployeeEntries):##vI:CategoryEntry)
    f485 :          SET : vLen : ##vLen + ($$StringLength:##vRec)
    f486 :          IF : ##vLen > @@FCRCap
    f487 :             SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f488 :             WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f489 :             INCREMENT : vPart
    f490 :             WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f491 :             SET : vLen : $$StringLength:##vRec
    f492 :          END IF
    f493 :          WRITE FILE : ##vRec
    f494 :          INCREMENT : vK
    f495 :       END WHILE
    f496 :       INCREMENT : vJ
    f497 :    END WHILE
    f498 :    INCREMENT : vI
    f499 : END WHILE
    f500 : SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f501 : WRITE FILE LINE : "|end=1|t1=" + ##vT + "|src=live"
    f502 : CLOSE TARGET FILE
    f503 : RETURN : Yes

;; ---------------------------------------------------------------- PROBE ONLY (branch push-probe, never shipped): which string functions this release evaluates
[Function: FCRProbe]
    Parameter : pEvent : String
    Variable  : plenA : String
    Variable  : plenB : String
    Variable  : plenN : Number
    Variable  : plenC : String
    Variable  : plenD : String
    Variable  : plenE : String
    Variable  : plenF : String
    Variable  : plenNarr : String
    Variable  : ppart : String
    Variable  : pfrep : String
    Variable  : prep : String
    Variable  : psrep : String
    Variable  : pstrrep : String
    Variable  : pword : String
    Variable  : pfind : String
    Variable  : psprintf : String
    Variable  : pupper : String
    Variable  : pneg1 : String
    Variable  : pneg2 : String
    Variable  : pamt1 : String
    Variable  : pdp1 : String
    Variable  : pnl : String
    Variable  : pGuid : String
    Variable  : pFile : String
    Variable  : pT : String
    Returns   : Logical

    q001 : SET : plenA : "unset"
    q002 : SET : plenB : "unset"
    q003 : SET : plenN : -1
    q004 : SET : plenC : "unset"
    q005 : SET : plenD : "unset"
    q006 : SET : plenE : "unset"
    q007 : SET : plenF : "unset"
    q008 : SET : plenNarr : "unset"
    q009 : SET : ppart : "unset"
    q010 : SET : pfrep : "unset"
    q011 : SET : prep : "unset"
    q012 : SET : psrep : "unset"
    q013 : SET : pstrrep : "unset"
    q014 : SET : pword : "unset"
    q015 : SET : pfind : "unset"
    q016 : SET : psprintf : "unset"
    q017 : SET : pupper : "unset"
    q018 : SET : pneg1 : "unset"
    q019 : SET : pneg2 : "unset"
    q020 : SET : pamt1 : "unset"
    q021 : SET : pdp1 : "unset"
    q022 : SET : pnl : "unset"
    q023 : SET : plenA : $$StringLength:"abc|d"
    q024 : SET : plenB : $$String:($$StringLength:"abc|d")
    q025 : SET : plenN : $$StringLength:"abc|d"
    q026 : SET : plenC : $$StrLength:"abc|d"
    q027 : SET : plenD : $$Length:"abc|d"
    q028 : SET : plenE : $$StringLen:"abc|d"
    q029 : SET : plenF : $$Len:"abc|d"
    q030 : SET : plenNarr : $$String:($$StringLength:($$String:$Narration))
    q031 : SET : ppart : $$StringPart:"abcdef":2:3
    q032 : SET : pfrep : $$StringFindAndReplace:"a|b|c":"|":"%7C"
    q033 : SET : prep : $$Replace:"a|b|c":"|":"%7C"
    q034 : SET : psrep : $$StrReplace:"a|b|c":"|":"%7C"
    q035 : SET : pstrrep : $$StringReplace:"a|b|c":"|":"%7C"
    q036 : SET : pword : $$StringWordEx:"a|b|c":"|":2
    q037 : SET : pfind : $$StringFind:"a|b":"|"
    q038 : SET : psprintf : $$SprintF:"%s-%s":"a":"b"
    q039 : SET : pupper : $$UpperCase:"ab"
    q040 : SET : pneg1 : $$CollectionField:($$String:@@FCRFNeg):1:AllLedgerEntries
    q041 : SET : pneg2 : $$CollectionField:($$String:($Amount < 0)):1:AllLedgerEntries
    q042 : SET : pamt1 : $$CollectionField:($$String:$Amount):1:AllLedgerEntries
    q043 : SET : pdp1 : $$CollectionField:($$String:$IsDeemedPositive):1:AllLedgerEntries
    q044 : SET : pnl : $$String:($$NumItems:AllLedgerEntries)
    q045 : SET : pGuid : $Guid:Company:##SVCurrentCompany
    q046 : SET : pFile : @@FCRFolder + ##pGuid + "-" + @@FCRDay + "-" + @@FCRWinUser + ".txt"
    q047 : IF : $$IsEmpty:@@FCRWinUser
    q048 :    SET : pFile : @@FCRFolder + ##pGuid + "-" + @@FCRDay + ".txt"
    q049 : END IF
    q050 : SET : pT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    q051 : OPEN FILE : ##pFile : Text : Write : Unicode
    q052 : IF : NOT $$LastResult
    q053 :    RETURN : Yes
    q054 : END IF
    q055 : WRITE FILE : "FCR1|ev=" + ##pEvent + "|t0=" + ##pT + "|tw=" + ##pT + "|w=" + @@FCRWinUser + "|cguid=" + ##pGuid + "|cname=" + ##SVCurrentCompany + "|user=|obj=Voucher|guid=|mid=|aid=|vtype=|vno=|vdate=|name=|parent=|narr="
    q056 : WRITE FILE : " lenA=[" + ##plenA + "]"
    q057 : WRITE FILE : " lenB=[" + ##plenB + "]"
    q058 : WRITE FILE : " lenN=[" + ($$String:##plenN) + "]"
    q059 : WRITE FILE : " lenC=[" + ##plenC + "]"
    q060 : WRITE FILE : " lenD=[" + ##plenD + "]"
    q061 : WRITE FILE : " lenE=[" + ##plenE + "]"
    q062 : WRITE FILE : " lenF=[" + ##plenF + "]"
    q063 : WRITE FILE : " lenNarr=[" + ##plenNarr + "]"
    q064 : WRITE FILE : " part=[" + ##ppart + "]"
    q065 : WRITE FILE : " frep=[" + ##pfrep + "]"
    q066 : WRITE FILE : " rep=[" + ##prep + "]"
    q067 : WRITE FILE : " srep=[" + ##psrep + "]"
    q068 : WRITE FILE : " strrep=[" + ##pstrrep + "]"
    q069 : WRITE FILE : " word=[" + ##pword + "]"
    q070 : WRITE FILE : " find=[" + ##pfind + "]"
    q071 : WRITE FILE : " sprintf=[" + ##psprintf + "]"
    q072 : WRITE FILE : " upper=[" + ##pupper + "]"
    q073 : WRITE FILE : " neg1=[" + ##pneg1 + "]"
    q074 : WRITE FILE : " neg2=[" + ##pneg2 + "]"
    q075 : WRITE FILE : " amt1=[" + ##pamt1 + "]"
    q076 : WRITE FILE : " dp1=[" + ##pdp1 + "]"
    q077 : WRITE FILE : " nl=[" + ##pnl + "]"
    q078 : WRITE FILE LINE : "|t1=" + ##pT + "|src=live"
    q079 : CLOSE TARGET FILE
    q080 : RETURN : Yes

;; ---------------------------------------------------------------- the one writer (heads only)
[Function: FCRLiveLog]
    Parameter : pEvent : String
    Variable  : vT0    : String
    Variable  : vTW    : String
    Variable  : vT1    : String
    Variable  : vGuid  : String
    Variable  : vFile  : String
    Variable  : vObj   : String
    Variable  : vLine  : String
    Returns   : Logical

    01 : SET    : vT0   : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)

    ;; company GUID; if Tally gives none here, "noguid" (never the company's name in a file path: review Low 17; the
    ;; line still carries cname)
    02 : SET    : vGuid : $Guid:Company:##SVCurrentCompany
    03 : IF     : $$IsEmpty:##vGuid
    04 :    SET : vGuid : "noguid"
    05 : END IF
    ;; the daily file: <company GUID>-<yyyymmdd>-<Windows user>.txt (next-userfile), or <company GUID>-<yyyymmdd>.txt
    ;; when Tally gives no Windows user
    06 : SET    : vFile : @@FCRFolder + ##vGuid + "-" + @@FCRDay + "-" + @@FCRWinUser + ".txt"
    06a: IF     : $$IsEmpty:@@FCRWinUser
    06b:    SET : vFile : @@FCRFolder + ##vGuid + "-" + @@FCRDay + ".txt"
    06c: END IF

    ;; object type: Voucher if it has a voucher type, Master if it has a name, else None
    07 : SET    : vObj  : "None"
    08 : IF     : NOT $$IsEmpty:$Name
    09 :    SET : vObj  : "Master"
    10 : END IF
    11 : IF     : NOT $$IsEmpty:$VoucherTypeName
    12 :    SET : vObj  : "Voucher"
    13 : END IF

    ;; the line (heads only: the bridge asks Tally for the body)
    14 : SET    : vLine : "FCR1|ev=" + ##pEvent + "|t0=" + ##vT0
    15 : SET    : vTW   : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    16 : SET    : vLine : ##vLine + "|tw=" + ##vTW + "|w=" + @@FCRWinUser
    17 : SET    : vLine : ##vLine + "|cguid=" + ##vGuid + "|cname=" + ##SVCurrentCompany
    18 : SET    : vLine : ##vLine + "|user=" + ($$String:$$CmpUserName) + "|obj=" + ##vObj
    19 : SET    : vLine : ##vLine + "|guid=" + ($$String:$Guid) + "|mid=" + ($$String:$MasterID)
    20 : SET    : vLine : ##vLine + "|aid=" + ($$String:$AlterID)
    21 : SET    : vLine : ##vLine + "|vtype=" + ($$String:$VoucherTypeName)
    22 : SET    : vLine : ##vLine + "|vno=" + ($$String:$VoucherNumber)
    23 : SET    : vLine : ##vLine + "|vdate=" + ($$String:$Date)
    24 : SET    : vLine : ##vLine + "|name=" + ($$String:$Name) + "|parent=" + ($$String:$Parent)
    25 : SET    : vLine : ##vLine + "|narr=" + ($$String:$Narration)

    ;; write: the daily file; if it cannot be opened, try failed.txt once; if that fails too, give
    ;; up quietly. Never a message, never a wait.
    26 : OPEN FILE : ##vFile : Text : Write : Unicode
    27 : IF     : NOT $$LastResult
    28 :    SET : vLine : "FCR1|ev=write_failed|file=" + ##vFile + "|was=" + ##vLine
    29 :    OPEN FILE : @@FCRFolder + "failed.txt" : Text : Write : Unicode
    30 :    IF  : NOT $$LastResult
    31 :       RETURN : Yes
    32 :    END IF
    33 : END IF
    34 : WRITE FILE      : ##vLine
    35 : SET             : vT1 : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    36 : WRITE FILE LINE : "|t1=" + ##vT1 + "|src=live"
    37 : CLOSE TARGET FILE
    38 : RETURN : Yes
