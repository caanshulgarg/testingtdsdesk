;; FinComRecorder.tdl  -  FinCom recorder, the LIVE add-on (bridge 2.2.0, plan round 20 a; notes for 2.2.1)
;;
;; Written next to the trial file FinComRecorderAnyCompany.tdl by the bridge's install step, in
;;     C:\ProgramData\FinCom\addon\FinComRecorder.tdl
;; The trial file is not changed. Load ONE of the two in Tally, never both (docs/recorder-live-sheet.txt).
;;
;; Purpose: for the company current in Tally (whichever company is loaded), append one heads-only
;; line per Tally event to a daily file
;;     C:\ProgramData\FinCom\recorder\<company GUID>-<yyyymmdd>.txt
;; FinCom Bridge 2.2.0 reads the newest 7 days of these files (it never writes, locks, renames or
;; deletes them), asks Tally itself for the body of a changed entry, and sends the changes to
;; FinCom's cloud. Everything except the one append below happens in the bridge, outside Tally.
;;
;; Rules kept here (the same as the trial's FCRLog):
;;   - silent: no menus, no keys, no buttons, no Message / Log / Query actions, no pop-ups;
;;   - never blocks a save, delete, cancel or import: every function returns Yes, and the form
;;     events always run Tally's own Form Accept;
;;   - writes for every company while it is loaded (no company-name check: the owner's decision
;;     of 04-Oct-2026); the bridge recognises FinCom's own entries by "TDSDesk:<id>" in the
;;     narration, so there is no text logic inside Tally;
;;   - no network, no AI, nothing but a local file append; a file that cannot be opened (held by
;;     another program) is never waited for: the line goes to failed.txt once, else it is dropped.
;;
;; NOT RUN ON A REAL TALLY. The constructs are the trial add-on's (docs/recorder-trial-review.md),
;; except the date in the file name (below).
;;
;; Line format (one line per event, fields always in this order, separator "|", key=value):
;;   FCR1|ev=|t0=|tw=|cguid=|cname=|user=|obj=|guid=|mid=|aid=|vtype=|vno=|vdate=|name=|parent=|narr=|t1=|src=live
;;   As the trial's, with "|src=live" written last, after t1, on the same line. narr is free text
;;   and may hold "|" or line breaks: a reader takes narr as everything between "|narr=" and the
;;   LAST "|t1=", and joins any line that does not start with "FCR1|" onto the line before it.
;; File character set: UNICODE as Tally writes it (UTF-16 little-endian), the 5th parameter of
;; OPEN FILE below.
;;
;; Bridge 2.2.1 (the owner's real-Tally result on NWS144, 05-Oct-2026). This file is unchanged in 2.2.1; what the
;; lines it writes were found to hold:
;;   - Times. t0, tw and t1 come from $$MachineTime, which gives hours and minutes:
;;     TDL gives the time to the minute only; save time is measured by the owner with a stopwatch.
;;     (t0 and t1 are both taken inside this one function, so t1 - t0 was never the save's time: save_ms was 0 on
;;     every line.) The bridge sends Tally's minute as saved_at and its own clock, to the second, as received_at when
;;     it first reads the line.
;;   - Created or altered. At Form Accept, before the save, Tally gives a NEW entry the GUID "<company GUID>-00000000",
;;     MasterID 0 and AlterID 0 (after the save: its MasterID, AlterID still 0); an entry altered carries its own
;;     numbers. The bridge takes these values as Tally's own create/alter state. Candidates for an explicit flag
;;     ($$InCreateMode, $$InAlterMode, a form's create/alter mode) were not added: none is confirmed on a real Tally,
;;     and a function Tally does not know stops the whole add-on from loading. Fallback (in force): the values above.
;;   - A Tally GUID is the company's GUID, "-", and the MasterID as 8 hex digits (Receipt 189: MasterID 26305 =
;;     66c1). The bridge rebuilds it from the MasterID, or finds the entry by its type and number on its date.
;;
;; The date in the file name: $$MachineDate (the construct the trial already uses) formatted with
;; Tally's "UniversalDate" format, which gives yyyymmdd (candidate). If a Tally gives anything else,
;; the fallback is to build it from the date's parts:
;;     $$ZeroFill:($$YearOfDate:$$MachineDate):4 + $$ZeroFill:($$MonthOfDate:$$MachineDate):2
;;       + $$ZeroFill:($$DayOfDate:$$MachineDate):2
;; The bridge reads every <GUID>-<anything>.txt (a line counts only when its own cguid starts its file's name), so
;; any date form still works; the beat names the files it read. After loading, check once that
;; C:\ProgramData\FinCom\recorder\ shows a new file ending in today's yyyymmdd (docs/recorder-live-sheet.txt).

;; Next (branch next-userfile; the owner's item b): every Windows user's Tally on a computer writes into the one
;; recorder folder, so each line now goes to that Windows user's OWN daily file
;;     C:\ProgramData\FinCom\recorder\<company GUID>-<yyyymmdd>-<Windows user>.txt
;; and carries "|w=<Windows user>" right after tw (an older bridge reads it as part of tw, which it does not need, and the
;; line still ends "|t1=...|src=live"). The Windows user is Tally's own $$SysInfo:WindowsUser, proven on a real
;; TallyPrime 7.1 (tally-real-spike run 37563133547: "runneradmin", the runner's Windows user, both through the XML port
;; and inside an add-on; a $$SysInfo parameter a release does not know gives "" there, not an error). When Tally gives
;; no user, the file is the shared <company GUID>-<yyyymmdd>.txt as before, and the bridge goes by its 2.3.0 rule.
;; Proven end to end in run 37580509870 (two Windows users, each with their own Tally, this add-on and this bridge): each
;; Tally wrote only <GUID>-7-Oct-26-<its user>.txt with w=<its user> on every line; each bridge read and sent only its own.

;; Next (branch next-push; the owner's decision of 07-Oct-2026, "full entry at save without read-back"; evidence: the push-design
;; re-run 37580283590 on branch tally-versions, docs/push-design-results.md, its harness add-on FCPFullNR.tdl): in the voucher
;; form, AFTER Tally's own save and after the two heads lines above (unchanged: an older bridge keeps reading them), one more
;; line, the FULL ENTRY as the form holds it in memory (FCRLiveFull below): no read-back of any kind (no collection walked,
;; nothing asked of the company), nothing written into Tally, nothing shown; it never blocks or fails the save (every path
;; returns Yes; a file that cannot be opened: nothing is written, the bridge asks Tally for the entry as before). Measured
;; with FCPFullNR on a 30,012-voucher company: 49-57 ms median, 71 ms worst for a 50-item invoice, on 3.0, 4.1, 5.1, 6.2, 7.1.
;;   FCR1|ev=voucher_full|t0=|tw=|w=|cguid=|cname=|user=|obj=Voucher|guid=|mid=|aid=|vtype=|vno=|vdate=|name=|parent=|narr=FE1|part=1|<fields>|end=1|t1=|src=live
;; An older bridge reads it as a complete line of an event it does not know, and drops it. The fields (bridge-go/pushline.go
;; has the whole format): the entry's own (mid, aid, guid, date, vtype, vno, party, canc, opt, view, ref, refdt, pgstin, pos,
;; cgstin, irn, irnack, irnackdt, ewb, narr), every ledger line (L<i>) with its GST rates (R), bills (B), bank details (K),
;; cost categories and centres (C, c) and TDS (T, its sub-categories s: category, party, assessable amount, tax, sub-category,
;; duty ledger), every item line (I<i>: item, quantities, rate, amount, HSN) with its rates, the ledgers under it (A) and its
;; batches (b: godown, batch, tracking and order numbers), the order list (O), a stock journal's lines out and in (SO, SI),
;; payroll and attendance (CE, E, p, a).
;; Separators: free text is written with its length, "name:<n>=<text>" ($$StringLength), so a name or narration holding "|",
;; "~", "=" or a line break is read exactly; Tally's own words (amounts, dates, Yes/No, rate heads) are written plain. The
;; sign of an amount: "neg" (the amount below 0). Size cap: once a line passes FCRCap characters the add-on ends it
;; ("|more=1|t1=...|src=live") and goes on in a new line with the same head and the next "|part=<k>"; a record is never split.
;; NOT RUN ON A REAL TALLY YET: $$StringLength and the "neg" formula are not used by any add-on proven so far; the
;; tally-real-spike scenario push233 is the first real run (a heads line still appearing there proves the file loads).

;; ---------------------------------------------------------------- the gate: a company is current
[System: Formula]
    FCRIsLive   : NOT $$IsEmpty:##SVCurrentCompany
    FCRFolder   : "C:\ProgramData\FinCom\recorder\"
    FCRDay      : $$String:$$MachineDate:"UniversalDate"
    FCRWinUser  : $$SysInfo:WindowsUser
    ;; next-push: the full entry's size cap per line (characters) and its records, each read in its own list item
    FCRCap     : 16000
    FCRFNeg    : $Amount < 0
    FCRFNegAss : $AssessableAmount < 0
    FCRFNegTax : $Tax < 0
    FCRFLe     : "led:" + ($$String:($$StringLength:($$String:$LedgerName))) + "=" + ($$String:$LedgerName) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg) + "~dp=" + ($$String:$IsDeemedPositive) + "~party=" + ($$String:$IsPartyLedger) + "~" + "hsn:" + ($$String:($$StringLength:($$String:$GSTHSNName))) + "=" + ($$String:$GSTHSNName)
    FCRFRate   : "head=" + ($$String:$GSTRateDutyHead) + "~vt=" + ($$String:$GSTRateValuationType) + "~rate=" + ($$String:$GSTRate)
    FCRFBill   : "name:" + ($$String:($$StringLength:($$String:$Name))) + "=" + ($$String:$Name) + "~type=" + ($$String:$BillType) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg) + "~" + "cp:" + ($$String:($$StringLength:($$String:$BillCreditPeriod))) + "=" + ($$String:$BillCreditPeriod) + "~" + "tdssec:" + ($$String:($$StringLength:($$String:$TDSDeducteeSectionNumber))) + "=" + ($$String:$TDSDeducteeSectionNumber)
    FCRFBank   : "date=" + ($$String:$Date) + "~" + "name:" + ($$String:($$StringLength:($$String:$Name))) + "=" + ($$String:$Name) + "~tt=" + ($$String:$TransactionType) + "~" + "ino:" + ($$String:($$StringLength:($$String:$InstrumentNumber))) + "=" + ($$String:$InstrumentNumber) + "~idt=" + ($$String:$InstrumentDate) + "~bdt=" + ($$String:$BankersDate) + "~" + "utr:" + ($$String:($$StringLength:($$String:$UniqueReferenceNumber))) + "=" + ($$String:$UniqueReferenceNumber) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg)
    FCRFCat    : "cat:" + ($$String:($$StringLength:($$String:$Category))) + "=" + ($$String:$Category)
    FCRFCC     : "cc:" + ($$String:($$StringLength:($$String:$Name))) + "=" + ($$String:$Name) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg)
    FCRFTax    : "tt=" + ($$String:$TaxType) + "~" + "cat:" + ($$String:($$StringLength:($$String:$Category))) + "=" + ($$String:$Category) + "~" + "pl:" + ($$String:($$StringLength:($$String:$PartyLedger))) + "=" + ($$String:$PartyLedger) + "~ref=" + ($$String:$RefType)
    FCRFSub    : "sub:" + ($$String:($$StringLength:($$String:$SubCategory))) + "=" + ($$String:$SubCategory) + "~" + "duty:" + ($$String:($$StringLength:($$String:$DutyLedger))) + "=" + ($$String:$DutyLedger) + "~rate=" + ($$String:$TaxRate) + "~ass=" + ($$String:$AssessableAmount) + "~assneg=" + ($$String:@@FCRFNegAss) + "~tax=" + ($$String:$Tax) + "~taxneg=" + ($$String:@@FCRFNegTax)
    FCRFIe     : "item:" + ($$String:($$StringLength:($$String:$StockItemName))) + "=" + ($$String:$StockItemName) + "~" + "qty:" + ($$String:($$StringLength:($$String:$BilledQty))) + "=" + ($$String:$BilledQty) + "~" + "aq:" + ($$String:($$StringLength:($$String:$ActualQty))) + "=" + ($$String:$ActualQty) + "~" + "rate:" + ($$String:($$StringLength:($$String:$Rate))) + "=" + ($$String:$Rate) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg) + "~dp=" + ($$String:$IsDeemedPositive) + "~" + "hsn:" + ($$String:($$StringLength:($$String:$GSTHSNName))) + "=" + ($$String:$GSTHSNName)
    FCRFAa     : "led:" + ($$String:($$StringLength:($$String:$LedgerName))) + "=" + ($$String:$LedgerName) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg) + "~dp=" + ($$String:$IsDeemedPositive)
    FCRFBat    : "god:" + ($$String:($$StringLength:($$String:$GodownName))) + "=" + ($$String:$GodownName) + "~" + "bat:" + ($$String:($$StringLength:($$String:$BatchName))) + "=" + ($$String:$BatchName) + "~" + "trk:" + ($$String:($$StringLength:($$String:$TrackingNumber))) + "=" + ($$String:$TrackingNumber) + "~" + "ord:" + ($$String:($$StringLength:($$String:$OrderNo))) + "=" + ($$String:$OrderNo) + "~due=" + ($$String:$OrderDueDate) + "~" + "aq:" + ($$String:($$StringLength:($$String:$ActualQty))) + "=" + ($$String:$ActualQty) + "~" + "bq:" + ($$String:($$StringLength:($$String:$BilledQty))) + "=" + ($$String:$BilledQty) + "~" + "rate:" + ($$String:($$StringLength:($$String:$BatchRate))) + "=" + ($$String:$BatchRate) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg)
    FCRFOrd    : "no:" + ($$String:($$StringLength:($$String:$BasicPurchaseOrderNo))) + "=" + ($$String:$BasicPurchaseOrderNo) + "~dt=" + ($$String:$BasicOrderDate)
    FCRFIo     : "item:" + ($$String:($$StringLength:($$String:$StockItemName))) + "=" + ($$String:$StockItemName) + "~" + "aq:" + ($$String:($$StringLength:($$String:$ActualQty))) + "=" + ($$String:$ActualQty) + "~" + "bq:" + ($$String:($$StringLength:($$String:$BilledQty))) + "=" + ($$String:$BilledQty) + "~" + "rate:" + ($$String:($$StringLength:($$String:$Rate))) + "=" + ($$String:$Rate) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg) + "~dp=" + ($$String:$IsDeemedPositive)
    FCRFCe     : "cat:" + ($$String:($$StringLength:($$String:$Category))) + "=" + ($$String:$Category)
    FCRFEmp    : "emp:" + ($$String:($$StringLength:($$String:$EmployeeName))) + "=" + ($$String:$EmployeeName) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg)
    FCRFPh     : "ph:" + ($$String:($$StringLength:($$String:$PayHeadName))) + "=" + ($$String:$PayHeadName) + "~amt=" + ($$String:$Amount) + "~neg=" + ($$String:@@FCRFNeg)
    FCRFAtt    : "att:" + ($$String:($$StringLength:($$String:$AttendanceType))) + "=" + ($$String:$AttendanceType) + "~" + "val:" + ($$String:($$StringLength:($$String:$AttdTypeValue))) + "=" + ($$String:$AttdTypeValue)

;; ---------------------------------------------------------------- system events (the trial's)
;; Syntax: <label> : <event> : <condition> : <action> : <action parameters>
[System: Events]
    FCRLDelBefore  : Before Delete Object : @@FCRIsLive : Call : FCRLiveLog : "before_delete"
    FCRLDelAfter   : After Delete Object  : @@FCRIsLive : Call : FCRLiveLog : "after_delete"
    FCRLCanBefore  : Before Cancel Object : @@FCRIsLive : Call : FCRLiveLog : "before_cancel"
    FCRLCanAfter   : After Cancel Object  : @@FCRIsLive : Call : FCRLiveLog : "after_cancel"
    FCRLImpStart   : Start Import         : @@FCRIsLive : Call : FCRLiveLog : "start_import"
    FCRLImpObject  : Import Object        : @@FCRIsLive : Call : FCRLiveLog : "import_object"
    FCRLImpAfter   : After Import Object  : @@FCRIsLive : Call : FCRLiveLog : "after_import_object"
    FCRLImpEnd     : End Import           : @@FCRIsLive : Call : FCRLiveLog : "end_import"

;; ---------------------------------------------------------------- create / alter on screen
;; Once a form has any "On : Form Accept" line, Tally's own save happens only through the
;; "Form Accept" action, so the middle line is required and is unconditional.
;; "_pre" is logged before Tally saves (a new entry has no GUID / MasterID yet), "_post" after.
[#Form: Voucher]
    On : Form Accept : @@FCRIsLive : Call : FCRLiveLog : "voucher_accept_pre"
    On : Form Accept : Yes          : Form Accept
    On : Form Accept : @@FCRIsLive : Call : FCRLiveLog : "voucher_accept_post"
    On : Form Accept : @@FCRIsLive : Call : FCRLiveFull : "voucher_full"
    On : Form Accept : @@FCRIsLive : Call : FCRProbe : "probe"

[#Form: Ledger]
    On : Form Accept : @@FCRIsLive : Call : FCRLiveLog : "ledger_accept_pre"
    On : Form Accept : Yes          : Form Accept
    On : Form Accept : @@FCRIsLive : Call : FCRLiveLog : "ledger_accept_post"

;; ---------------------------------------------------------------- next-push: the full entry, after the save (no read-back)
;; The entry as the voucher form holds it once Tally has saved it, written to the same daily file as the heads lines. One OPEN
;; FILE and one CLOSE; never a wait, never a message; nothing is read from the company.
[Function: FCRLiveFull]
    Parameter : pEvent : String
    Variable  : vHead  : String
    Variable  : vRec   : String
    Variable  : vT     : String
    Variable  : vGuid  : String
    Variable  : vFile  : String
    Variable  : vLen   : Number
    Variable  : vPart  : Number
    Variable  : vI     : Number
    Variable  : vJ     : Number
    Variable  : vK     : Number
    Variable  : vM     : Number
    Variable  : vNI    : Number
    Variable  : vNJ    : Number
    Variable  : vNK    : Number
    Variable  : vNM    : Number
    Returns   : Logical

    f001 : SET : vGuid : $Guid:Company:##SVCurrentCompany
    f002 : IF : $$IsEmpty:##vGuid
    f003 :    SET : vGuid : "noguid"
    f004 : END IF
    f005 : SET : vFile : @@FCRFolder + ##vGuid + "-" + @@FCRDay + "-" + @@FCRWinUser + ".txt"
    f006 : IF : $$IsEmpty:@@FCRWinUser
    f007 :    SET : vFile : @@FCRFolder + ##vGuid + "-" + @@FCRDay + ".txt"
    f008 : END IF
    f009 : SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f010 : SET : vHead : "FCR1|ev=" + ##pEvent + "|t0=" + ##vT + "|tw=" + ##vT + "|w=" + @@FCRWinUser
    f011 : SET : vHead : ##vHead + "|cguid=" + ##vGuid + "|cname=" + ##SVCurrentCompany + "|user=" + ($$String:$$CmpUserName) + "|obj=Voucher"
    f012 : SET : vHead : ##vHead + "|guid=" + ($$String:$Guid) + "|mid=" + ($$String:$MasterID) + "|aid=" + ($$String:$AlterID)
    f013 : SET : vHead : ##vHead + "|vtype=" + ($$String:$VoucherTypeName) + "|vno=" + ($$String:$VoucherNumber) + "|vdate=" + ($$String:$Date)
    f014 : SET : vHead : ##vHead + "|name=|parent=|narr=FE1"
    f015 : OPEN FILE : ##vFile : Text : Write : Unicode
    f016 : IF : NOT $$LastResult
    f017 :    RETURN : Yes
    f018 : END IF
    f019 : SET : vPart : 1
    f020 : SET : vLen : 0
    f021 : WRITE FILE : ##vHead + "|part=1"
    f022 : SET : vRec : "|mid=" + ($$String:$MasterID) + "|aid=" + ($$String:$AlterID) + "|guid=" + ($$String:$Guid) + "|date=" + ($$String:$Date) + "|canc=" + ($$String:$IsCancelled) + "|opt=" + ($$String:$IsOptional)
    f023 : SET : vLen : ##vLen + ($$StringLength:##vRec)
    f024 : IF : ##vLen > @@FCRCap
    f025 :    SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f026 :    WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f027 :    INCREMENT : vPart
    f028 :    WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f029 :    SET : vLen : $$StringLength:##vRec
    f030 : END IF
    f031 : WRITE FILE : ##vRec
    f032 : SET : vRec : "|vtype:" + ($$String:($$StringLength:($$String:$VoucherTypeName))) + "=" + ($$String:$VoucherTypeName) + "|vno:" + ($$String:($$StringLength:($$String:$VoucherNumber))) + "=" + ($$String:$VoucherNumber) + "|party:" + ($$String:($$StringLength:($$String:$PartyLedgerName))) + "=" + ($$String:$PartyLedgerName) + "|view:" + ($$String:($$StringLength:($$String:$PersistedView))) + "=" + ($$String:$PersistedView)
    f033 : SET : vLen : ##vLen + ($$StringLength:##vRec)
    f034 : IF : ##vLen > @@FCRCap
    f035 :    SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f036 :    WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f037 :    INCREMENT : vPart
    f038 :    WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f039 :    SET : vLen : $$StringLength:##vRec
    f040 : END IF
    f041 : WRITE FILE : ##vRec
    f042 : SET : vRec : "|ref:" + ($$String:($$StringLength:($$String:$Reference))) + "=" + ($$String:$Reference) + "|refdt=" + ($$String:$ReferenceDate) + "|pgstin:" + ($$String:($$StringLength:($$String:$PartyGSTIN))) + "=" + ($$String:$PartyGSTIN) + "|pos:" + ($$String:($$StringLength:($$String:$PlaceOfSupply))) + "=" + ($$String:$PlaceOfSupply) + "|cgstin:" + ($$String:($$StringLength:($$String:$CmpGSTIN))) + "=" + ($$String:$CmpGSTIN)
    f043 : SET : vLen : ##vLen + ($$StringLength:##vRec)
    f044 : IF : ##vLen > @@FCRCap
    f045 :    SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f046 :    WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f047 :    INCREMENT : vPart
    f048 :    WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f049 :    SET : vLen : $$StringLength:##vRec
    f050 : END IF
    f051 : WRITE FILE : ##vRec
    f052 : SET : vRec : "|irn:" + ($$String:($$StringLength:($$String:$IRN))) + "=" + ($$String:$IRN) + "|irnack:" + ($$String:($$StringLength:($$String:$IRNAckNo))) + "=" + ($$String:$IRNAckNo) + "|irnackdt=" + ($$String:$IRNAckDate) + "|ewb:" + ($$String:($$StringLength:($$String:($$CollectionField:$BillNumber:1:EWayBillDetails)))) + "=" + ($$String:($$CollectionField:$BillNumber:1:EWayBillDetails))
    f053 : SET : vLen : ##vLen + ($$StringLength:##vRec)
    f054 : IF : ##vLen > @@FCRCap
    f055 :    SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f056 :    WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f057 :    INCREMENT : vPart
    f058 :    WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f059 :    SET : vLen : $$StringLength:##vRec
    f060 : END IF
    f061 : WRITE FILE : ##vRec
    f062 : SET : vRec : "|narr:" + ($$String:($$StringLength:($$String:$Narration))) + "=" + ($$String:$Narration)
    f063 : SET : vLen : ##vLen + ($$StringLength:##vRec)
    f064 : IF : ##vLen > @@FCRCap
    f065 :    SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f066 :    WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f067 :    INCREMENT : vPart
    f068 :    WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f069 :    SET : vLen : $$StringLength:##vRec
    f070 : END IF
    f071 : WRITE FILE : ##vRec
    f072 : SET : vNI : 0
    f073 : SET : vNI : $$NumItems:AllLedgerEntries
    f074 : SET : vRec : "|nL=" + ($$String:##vNI)
    f075 : SET : vLen : ##vLen + ($$StringLength:##vRec)
    f076 : IF : ##vLen > @@FCRCap
    f077 :    SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f078 :    WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f079 :    INCREMENT : vPart
    f080 :    WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f081 :    SET : vLen : $$StringLength:##vRec
    f082 : END IF
    f083 : WRITE FILE : ##vRec
    f084 : SET : vI : 1
    f085 : WHILE : ##vI <= ##vNI
    f086 :    SET : vRec : "|L" + ($$String:##vI) + "=" + ($$CollectionField:@@FCRFLe:##vI:AllLedgerEntries)
    f087 :    SET : vLen : ##vLen + ($$StringLength:##vRec)
    f088 :    IF : ##vLen > @@FCRCap
    f089 :       SET : vT : ($$String:$$MachineDate) + " " + ($$String:$$MachineTime)
    f090 :       WRITE FILE LINE : "|more=1|t1=" + ##vT + "|src=live"
    f091 :       INCREMENT : vPart
    f092 :       WRITE FILE : ##vHead + "|part=" + ($$String:##vPart)
    f093 :       SET : vLen : $$StringLength:##vRec
    f094 :    END IF
