;; FCPM_PayHead.tdl  -  MEASUREMENT ONLY (push-design spike). Loaded beside FCPFull.tdl in the voucher-type probe only: does the
;; "Pay Head" form accept an On : Form Accept hook, and what does a line of it hold? A form name this release does not
;; know fails this file alone. Writes to the same full-<company GUID>-<day>.txt as FCPFull.tdl.

[#Form: Pay Head]
    On : Form Accept : Yes : Call : FCPStamp : "mpaa"
    On : Form Accept : Yes : Form Accept
    On : Form Accept : Yes : Call : FCPStamp : "mpac"
    On : Form Accept : Yes : Call : FCPMPayHeadW : "payhead_saved"

[Function: FCPMPayHeadW]
    Parameter : pEvent : String
    Variable  : vCG : String
    Returns   : Logical
    01 : SET : vCG : $Guid:Company:##SVCurrentCompany
    02 : OPEN FILE : "C:\fcspike\push\full-" + ##vCG + "-" + ($$String:$$MachineDate:"UniversalDate") + ".txt" : Text : Write : Unicode
    03 : IF : NOT $$LastResult
    04 :    RETURN : Yes
    05 : END IF
    06 : WRITE FILE : "FCF1|ev=" + ##pEvent + "|form=Pay Head|cguid=" + ##vCG
    07 : WRITE FILE : "|guid=" + ($$String:$Guid)
    08 : WRITE FILE : "|mid=" + ($$String:$MasterID)
    09 : WRITE FILE : "|aid=" + ($$String:$AlterID)
    10 : WRITE FILE : "|name=" + ($$String:$Name)
    11 : WRITE FILE : "|parent=" + ($$String:$Parent)
    12 : WRITE FILE : "|paytype=" + ($$String:$PayType)
    13 : WRITE FILE : "|calculationtype=" + ($$String:$CalculationType)
    14 : WRITE FILE : "|affectsnetsalary=" + ($$String:$AffectsNetSalary)
    15 : WRITE FILE : "|forpayroll=" + ($$String:$ForPayroll)
    16 : WRITE FILE : "|iscostcentreson=" + ($$String:$IsCostCentresOn)
    17 : WRITE FILE LINE : "|end=1"
    18 : CLOSE TARGET FILE
    19 : RETURN : Yes
