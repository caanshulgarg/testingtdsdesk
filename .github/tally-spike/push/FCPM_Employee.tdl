;; FCPM_Employee.tdl  -  MEASUREMENT ONLY (push-design spike). Loaded beside FCPFull.tdl in the voucher-type probe only: does the
;; "Employee" form accept an On : Form Accept hook, and what does a line of it hold? A form name this release does not
;; know fails this file alone. Writes to the same full-<company GUID>-<day>.txt as FCPFull.tdl.

[#Form: Employee]
    On : Form Accept : Yes : Call : FCPStamp : "mema"
    On : Form Accept : Yes : Form Accept
    On : Form Accept : Yes : Call : FCPStamp : "memc"
    On : Form Accept : Yes : Call : FCPMEmployeeW : "employee_saved"

[Function: FCPMEmployeeW]
    Parameter : pEvent : String
    Variable  : vCG : String
    Returns   : Logical
    01 : SET : vCG : $Guid:Company:##SVCurrentCompany
    02 : OPEN FILE : "C:\fcspike\push\full-" + ##vCG + "-" + ($$String:$$MachineDate:"UniversalDate") + ".txt" : Text : Write : Unicode
    03 : IF : NOT $$LastResult
    04 :    RETURN : Yes
    05 : END IF
    06 : WRITE FILE : "FCF1|ev=" + ##pEvent + "|form=Employee|cguid=" + ##vCG
    07 : WRITE FILE : "|guid=" + ($$String:$Guid)
    08 : WRITE FILE : "|mid=" + ($$String:$MasterID)
    09 : WRITE FILE : "|aid=" + ($$String:$AlterID)
    10 : WRITE FILE : "|name=" + ($$String:$Name)
    11 : WRITE FILE : "|parent=" + ($$String:$Parent)
    12 : WRITE FILE : "|category=" + ($$String:$Category)
    13 : WRITE FILE : "|dateofjoin=" + ($$String:$DateOfJoin)
    14 : WRITE FILE : "|designation=" + ($$String:$Designation)
    15 : WRITE FILE : "|employeenumber=" + ($$String:$EmployeeNumber)
    16 : WRITE FILE : "|forpayroll=" + ($$String:$ForPayroll)
    17 : WRITE FILE : "|gender=" + ($$String:$Gender)
    18 : WRITE FILE : "|pannumber=" + ($$String:$PANNumber)
    19 : WRITE FILE LINE : "|end=1"
    20 : CLOSE TARGET FILE
    21 : RETURN : Yes
