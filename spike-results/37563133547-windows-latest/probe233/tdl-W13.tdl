[#Form: Ledger]
    On : Form Accept : Yes : Call : P233W13F

[Function: P233W13F]
    Variable : v : String
    Returns  : Logical
    01 : SET : v : $$SysInfo:SystemName
    02 : OPEN FILE : "C:\fcspike\p233\out-W13.txt" : Text : Write : Unicode
    03 : IF : NOT $$LastResult
    04 :    RETURN : Yes
    05 : END IF
    06 : WRITE FILE LINE : "SysInfo:SystemName=" + ##v
    07 : CLOSE TARGET FILE
    08 : RETURN : Yes
