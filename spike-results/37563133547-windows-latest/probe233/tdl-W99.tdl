[#Form: Ledger]
    On : Form Accept : Yes : Call : P233W99F

[Function: P233W99F]
    Returns  : Logical
    01 : OPEN FILE : "C:\fcspike\p233\env-%USERNAME%.txt" : Text : Write : Unicode
    02 : IF : NOT $$LastResult
    03 :    RETURN : Yes
    04 : END IF
    05 : WRITE FILE LINE : "pct"
    06 : CLOSE TARGET FILE
    07 : RETURN : Yes
