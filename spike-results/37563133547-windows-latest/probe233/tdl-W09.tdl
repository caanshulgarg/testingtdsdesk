[#Form: Ledger]
    On : Form Accept : Yes : Call : P233W09F

[Function: P233W09F]
    Variable : v : String
    Returns  : Logical
    01 : SET : v : $$SysInfo:LoggedInUser
    02 : OPEN FILE : "C:\fcspike\p233\out-W09.txt" : Text : Write : Unicode
    03 : IF : NOT $$LastResult
    04 :    RETURN : Yes
    05 : END IF
    06 : WRITE FILE LINE : "SysInfo:LoggedInUser=" + ##v
    07 : CLOSE TARGET FILE
    08 : RETURN : Yes
