[#Form: Ledger]
    On : Form Accept : Yes : Call : P233W21F

[Function: P233W21F]
    Variable : v : String
    Returns  : Logical
    01 : SET : v : $$GetEnvVar:"USERNAME"
    02 : OPEN FILE : "C:\fcspike\p233\out-W21.txt" : Text : Write : Unicode
    03 : IF : NOT $$LastResult
    04 :    RETURN : Yes
    05 : END IF
    06 : WRITE FILE LINE : "GetEnvVar:USERNAME=" + ##v
    07 : CLOSE TARGET FILE
    08 : RETURN : Yes
