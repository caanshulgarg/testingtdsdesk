[#Form: Ledger]
    On : Form Accept : Yes : Call : P233W23F

[Function: P233W23F]
    Variable : v : String
    Returns  : Logical
    01 : SET : v : $$EnvVar:"USERNAME"
    02 : OPEN FILE : "C:\fcspike\p233\out-W23.txt" : Text : Write : Unicode
    03 : IF : NOT $$LastResult
    04 :    RETURN : Yes
    05 : END IF
    06 : WRITE FILE LINE : "EnvVar:USERNAME=" + ##v
    07 : CLOSE TARGET FILE
    08 : RETURN : Yes
