[#Form: Ledger]
    On : Form Accept : Yes : Call : P233W22F

[Function: P233W22F]
    Variable : v : String
    Returns  : Logical
    01 : SET : v : $$GetEnvironmentVariable:"USERNAME"
    02 : OPEN FILE : "C:\fcspike\p233\out-W22.txt" : Text : Write : Unicode
    03 : IF : NOT $$LastResult
    04 :    RETURN : Yes
    05 : END IF
    06 : WRITE FILE LINE : "GetEnvironmentVariable:USERNAME=" + ##v
    07 : CLOSE TARGET FILE
    08 : RETURN : Yes
