[#Form: Unit]
    On : Form Accept : Yes : Form Accept

[Function: P233U_acceptF]
    Parameter : pEv : String
    Returns   : Logical
    01 : OPEN FILE : "C:\fcspike\p233\hook-U_accept.txt" : Text : Write : Unicode
    02 : IF : NOT $$LastResult
    03 :    RETURN : Yes
    04 : END IF
    05 : WRITE FILE LINE : "ev=" + ##pEv + "|form=Unit|name=" + ($$String:$Name) + "|guid=" + ($$String:$Guid) + "|mid=" + ($$String:$MasterID) + "|aid=" + ($$String:$AlterID) + "|parent=" + ($$String:$Parent) + "|t=" + ($$String:$$MachineTime)
    06 : CLOSE TARGET FILE
    07 : RETURN : Yes
