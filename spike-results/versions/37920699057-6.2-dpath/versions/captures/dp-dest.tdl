;; dpath probe dest (tally-versions mode dpath, harness only): after Tally's save and in the delete / cancel events
[#Form: Voucher]
    On : Form Accept : Yes : Call : FCDPWdest : "accept_post"

[System: Events]
    FCDPEdesta : Before Delete Object : Yes : Call : FCDPWdest : "before_delete"
    FCDPEdestb : After Delete Object : Yes : Call : FCDPWdest : "after_delete"
    FCDPEdestc : Before Cancel Object : Yes : Call : FCDPWdest : "before_cancel"
    FCDPEdestd : After Cancel Object : Yes : Call : FCDPWdest : "after_cancel"

[Function: FCDPWdest]
    Parameter : pEv : String
    Variable  : vV  : String
    Variable  : vA  : String
    Variable  : vB  : String
    Variable  : vH  : String
    Returns   : Logical
    000 : SET : vA : $Guid:Company:##SVCurrentCompany
    001 : SET : vH : "FCDP|f=dest|ev=" + ##pEv + "|cg=" + ##vA + "|mid=" + ($$String:$MasterID) + "|aid=" + ($$String:$AlterID)
    002 : SET : vH : ##vH + "|vt=" + ($$String:$VoucherTypeName) + "|vno=" + ($$String:$VoucherNumber)
    003 : OPEN FILE : "C:\fcspike\dpath\probe.txt" : Text : Write : Unicode
    004 : IF : NOT $$LastResult
    005 :    RETURN : Yes
    006 : END IF
    010 : SET : vV : $Destination:Company:##SVCurrentCompany
    011 : WRITE FILE LINE : ##vH + "|k=dest|v=" + ##vV + "|end"
    012 : CLOSE TARGET FILE
    013 : RETURN : Yes
