;; probe-brs2.tdl (bank-date probe, harness only)
[#Form: BankRecon]
    Add : Button : FCRPB2
    On : Form Accept : Yes : Call : FCRPWrite : "brs2_pre"
    On : Form Accept : Yes : Form Accept
    On : Form Accept : Yes : Call : FCRPWrite : "brs2_post"

[Button: FCRPB2]
    Key    : Ctrl+Alt+B
    Title  : "Lotus Mark"
    Action : Display : Day Book

[Collection: FCRPAlivebrs2]
    Type : Company

