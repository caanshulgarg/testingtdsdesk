{
  "manifest_version": 3,
  "name": "FinCom GST helper",
  "short_name": "FinCom GST",
  "version": "0.1.0",
  "description": "Fills GSTR-1, IFF and GSTR-3B on the GST portal from FinCom's figures, in your own logged-in tab, and stops before File. You type the captcha, the OTP and you file.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "sw.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "FinCom GST helper", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://*.gst.gov.in/*"],
  "content_scripts": [{ "matches": ["https://*.gst.gov.in/*"], "js": ["lib/rules.js", "selectors.js", "content.js"], "run_at": "document_idle" }],
  "externally_connectable": { "matches": ["https://staging.fincom.live/*"] }
}
