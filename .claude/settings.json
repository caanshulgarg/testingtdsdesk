{
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ECC"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "ecc@ecc": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "insecure-defaults@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "differential-review@trailofbits": true,
    "static-analysis@trailofbits": true,
    "variant-analysis@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "fp-check@trailofbits": true,
    "audit-context-building@trailofbits": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-production.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git push origin *:refs/heads/staging-next)",
      "Bash(git push -u origin next-*)",
      "Bash(git push origin next-*)",
      "Bash(*publish-preview.sh review *)",
      "Bash(gh api -X POST repos/caanshulgarg/testingtdsdesk/actions/workflows/*/dispatches *)",
      "mcp__Supabase__deploy_edge_function"
    ]
  }
}
