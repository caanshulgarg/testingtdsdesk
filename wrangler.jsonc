// Cloudflare (Workers & Pages, the Worker "testingtdsdesk"): how main is put on the web (docs/CLOUDFLARE.md).
// Only cf-site/ is served, which cloudflare/build-site.sh makes from an allow-list before each deploy.
{
  "name": "testingtdsdesk",
  "compatibility_date": "2026-10-01",
  "build": { "command": "sh cloudflare/build-site.sh" },
  "assets": {
    "directory": "./cf-site",
    // /x.html -> /x and /x/index.html -> /x/ (as Pages); /review -> /review/
    "html_handling": "auto-trailing-slash",
    // a missing file is a 404 with /404.html (never the root page with 200)
    "not_found_handling": "404-page"
  },
  // the *.workers.dev address stays on for testing; staging.fincom.live is added as a Custom Domain in the dashboard
  "workers_dev": true,
  "preview_urls": false
}
